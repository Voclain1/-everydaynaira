# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://everydaynaira.com

# Newsletter — set ONE provider
# Brevo (free tier: 300 emails/day). Create a list and copy its numeric ID.
BREVO_API_KEY=
BREVO_LIST_ID=
# Or post sign-ups to any webhook (Zapier, Make, n8n, Google Apps Script)
NEWSLETTER_WEBHOOK_URL=

# Contact form — Resend (free tier: 3,000 emails/month)
RESEND_API_KEY=
CONTACT_TO_EMAIL=ben@everydaynaira.com
CONTACT_FROM_EMAIL=EverydayNaira <hello@everydaynaira.com>

# Google AdSense (leave blank to load no ads). ads.txt is already in /public.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXX
NEXT_PUBLIC_GA_ID=
