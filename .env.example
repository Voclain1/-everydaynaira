# Canonical site host is https://www.everydaynaira.com (fixed in lib/site.ts).
# Set the same www domain in your hosting dashboard and redirect the apex to it.

# Newsletter — set ONE provider
# Brevo (free tier: 300 emails/day). Create a list and copy its numeric ID.
BREVO_API_KEY=
BREVO_LIST_ID=
# Or post sign-ups to any webhook (Zapier, Make, n8n, Google Apps Script)
NEWSLETTER_WEBHOOK_URL=

# Contact form — Resend (free tier: 3,000 emails/month)
RESEND_API_KEY=
CONTACT_TO_EMAIL=ben@everydaynaira.com
CONTACT_FROM_EMAIL=EverydayNaira <hello@everydaynaira.com>

# Google AdSense (leave blank to load no ads). ads.txt is already in /public.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXX
NEXT_PUBLIC_GA_ID=

# Accounts and dashboards — Supabase (Sprint 6)
# Create a free project at supabase.com, then copy these from Project Settings → API.
# The publishable key is safe to expose in the browser; Row Level Security
# limits every reader to their own rows. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY_HERE
